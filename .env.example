# ============================================================
# 4 Ajanlı Sabah Finans Brifingi — Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın: cp .env.example .env
# ============================================================

# --- Genel ---
TIMEZONE=Europe/Istanbul
PIPELINE_START_TIME=07:30        # Ajan 1 başlangıcı (hafta içi)
DISPATCH_TIME=08:15              # Ajan 4 gönderim saati (tam bu saatte)
OUTPUT_DIR=output
LOG_LEVEL=INFO

# --- Ajan 1: Veri Toplama ---
# Yapay zekâ ile küratörlük ve konuşma metni: gemini | anthropic | none
# (boşsa tanımlı anahtara göre otomatik; Gemini, GEMINI_API_KEY'i kullanır)
LLM_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-3.8-flash
# Claude ile küratörlük (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Tier-1 haber akışları (virgülle ayrılmış "Kaynak|URL" çiftleri).
# Bloomberg / Reuters içeriği lisanslıdır: kurumunuzun lisanslı feed URL'lerini girin.
NEWS_FEEDS=Bloomberg HT|https://www.bloomberght.com/rss,Foreks|https://www.foreks.com/rss,TCMB|https://www.tcmb.gov.tr/wps/wcm/connect/TR/TCMB+TR/Bottom+Menu/Diger/RSS/Basin+Duyurulari
BLOOMBERG_FEED_URL=
REUTERS_FEED_URL=
FOREKS_FEED_URL=
# KAP'ın resmi RSS/açık API'si yok; lisanslı bir KAP veri akışınız varsa aşağıya girin
KAP_FEED_URL=
# Bankaların kendi basın bültenleri (Garanti BBVA, Akbank, Yapı Kredi, QNB) → Bankacılık Gündemi
BANK_NEWS_ENABLED=true
# 4 Büyük Banka bölümüne basından (Google Haberler, güvenilir yayınlar) ve KAP'tan son haberler
BANK_MENTIONS_ENABLED=true

# KAP bildirimleri (kap.org.tr'nin kendi sayfaları için kullandığı servis; resmi API değildir)
KAP_ENABLED=true
KAP_MAX_ITEMS=8
KAP_WATCHLIST=kap_watchlist.txt          # öncelikli şirketler (satır başına şirket adı parçası)
KAP_SNAPSHOT_TIME=18:30,23:50         # servis yalnızca günün bildirimlerini verir; akşam + gece kopyası

# Haber arama penceresi (saat)
NEWS_LOOKBACK_HOURS=18



# --- Ajan 3: Video / Ses ---
VIDEO_PROVIDER=gemini            # gemini | elevenlabs | heygen | did | none
VOICE_SPEED=1.25
# Gemini (Google AI Studio → https://aistudio.google.com/apikey)
# Ses doğal tempoda üretilir, VOICE_SPEED'e ffmpeg ile getirilir; bülten kartıyla MP4 yapılır.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts        # daha ucuz/hızlı: gemini-3.8-flash-lite-tts
GEMINI_VOICE=Kore                            # kadın: Kore, Aoede, Leda, Zephyr, Despina | erkek: Charon, Orus, Puck
GEMINI_TTS_STYLE=Deneyimli bir kadın ekonomi spikeri sabah bültenini sunuyor; doğal, akıcı ve sıcak bir anlatım, rakamları ve birimleri net ve vurgulu okuyor, cümle aralarında doğal nefes payı bırakıyor
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
DID_API_KEY=
DID_SOURCE_URL=                  # D-ID için spiker görsel URL'i
# Videonun bülteni bekletebileceği son an (bu saate kadar hazır değilse bülten videosuz gider)
VIDEO_DEADLINE=08:10
# E-postadaki "Dinle" bağlantısı: bu Mac'teki yerel medya sunucusu (zamanlayıcıyla birlikte çalışır).
# Telefonda da açılsın isterseniz dosyaları herkese açık bir adrese yükleyip buraya o adresi yazın.
MEDIA_SERVER_PORT=8765
MEDIA_PUBLIC_BASE_URL=http://localhost:8765

# --- Ajan 4: Gönderim ---
EMAIL_PROVIDER=resend            # resend | smtp
EMAIL_FROM=Sabah Brifingi <brifing@ornek.com.tr>
SUBSCRIBERS=ad.soyad@ornek.com.tr,ekip@ornek.com.tr
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
